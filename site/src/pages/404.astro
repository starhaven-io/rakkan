---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { markRouteNotFound } from '../lib/cache.ts';
import { registrySite, registrySlugForPath } from '../lib/registries.ts';

const slug = registrySlugForPath(Astro.url.pathname);
const site = registrySite(slug);
markRouteNotFound(Astro.response);
---

<Base registry={slug} title="Not found · rakkan" freshness={false}>
  <section class="empty-state">
    <h1>Not found</h1>
    <p>
      No such page, or a package this tracker has never recorded.
      <a href={site.packagesPath}>Browse the full index</a> or search above.
    </p>
  </section>
</Base>
