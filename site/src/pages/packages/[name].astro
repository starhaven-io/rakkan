---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getDb } from '../../lib/db.ts';
import { packageByName, registryByName, versionsOf } from '../../lib/d1.ts';
import {
  formatCount,
  packageNoun,
  provenanceLabel,
  repositoryLabel,
  safeHttpsUrl,
  shortDate,
} from '../../lib/format.ts';

const db = getDb();
const name = Astro.params.name ?? '';
const registry = await registryByName(db, 'rubygems');
const pkg = registry ? await packageByName(db, registry.id, name) : null;

if (!registry || !pkg) {
  return Astro.rewrite('/404');
}

const versions = await versionsOf(db, registry.id, pkg.name);
const registryPackageUrl =
  registry.name === 'rubygems' ? `https://rubygems.org/gems/${pkg.name}` : null;
---

<Base title={`${pkg.name} · rakkan`}>
  <a class="back-link" href="/">← {registry.display_name} overview</a>

  <section class="package-hero">
    <div class="hero-copy">
      <h1 class="package-name">{pkg.name}</h1>
      {
        pkg.first_provenant_at ? (
          <span class="badge yes">Provenance since {shortDate(pkg.first_provenant_at)}</span>
        ) : (
          <span class="badge neutral">No provenance observed</span>
        )
      }
      {pkg.tracked !== 1 && <span class="badge neutral">No longer in the tracked set</span>}
      <div class="package-meta">
        {pkg.rank != null && (
          <span>
            Rank <strong>#{formatCount(pkg.rank)}</strong>
          </span>
        )}
        <span><strong>{formatCount(pkg.downloads_total ?? 0)}</strong> downloads</span>
        <span><strong>{formatCount(versions.length)}</strong> recorded versions</span>
      </div>
    </div>
    <div class="hero-actions">
      {registryPackageUrl && <a href={registryPackageUrl}>{registry.display_name} ↗</a>}
    </div>
  </section>

  <section class="panel">
    <header class="panel-header">
      <div>
        <h3>Release provenance</h3>
        <p>Certificate-derived build identity per recorded version.</p>
      </div>
      <span class="panel-meta">{versions.length} versions</span>
    </header>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Version</th>
            <th>Platform</th>
            <th>Published</th>
            <th>Provenance</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {
            versions.map((version) => {
              const repoUrl = safeHttpsUrl(version.source_repository);
              const runUrl = safeHttpsUrl(version.run_url);
              return (
                <tr>
                  <td>
                    <span class="package-name">{version.number}</span>
                    <span class="version-flags">
                      {version.prerelease === 1 && <span class="badge neutral">Pre</span>}
                      {version.yanked === 1 && <span class="badge danger">Yanked</span>}
                    </span>
                  </td>
                  <td>{version.platform || '—'}</td>
                  <td class="date-cell">{shortDate(version.published_at)}</td>
                  <td>
                    {version.provenance_kind ? (
                      <span class="badge yes">
                        {provenanceLabel(version.provenance_kind)}
                        {version.attestation_count > 1 ? ` ×${version.attestation_count}` : ''}
                      </span>
                    ) : version.provenance_checked_at ? (
                      <span class="badge neutral">None observed</span>
                    ) : (
                      <span class="faint">Unchecked</span>
                    )}
                  </td>
                  <td>
                    {repoUrl ? (
                      <span class="source-links">
                        <a href={repoUrl}>{repositoryLabel(repoUrl)}</a>
                        {runUrl && (
                          <a class="run-link" href={runUrl}>
                            Build run ↗
                          </a>
                        )}
                      </span>
                    ) : version.source_repository ? (
                      <span class="faint">{version.source_repository}</span>
                    ) : (
                      <span class="faint">—</span>
                    )}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>
