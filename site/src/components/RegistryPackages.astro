---
import Base from '../layouts/Base.astro';
import Pagination from './Pagination.astro';
import type { PageResult, PackageRow, Registry, TrackedSummary } from '../lib/d1.ts';
import { formatCount, packageNoun, shortDate } from '../lib/format.ts';
import { registrySite, type RegistrySlug } from '../lib/registries.ts';

interface Props {
  slug: RegistrySlug;
  registry: Registry | null;
  packagePage: PageResult<PackageRow> | null;
  summary: TrackedSummary;
}

const { slug, registry, packagePage, summary } = Astro.props;
const site = registrySite(slug);
const packages = packagePage?.items ?? [];
const noun = packageNoun(registry?.name, 2);
---

<Base
  registry={slug}
  canonicalPath={site.packagesPath}
  title={`All ${noun} · rakkan`}
  description={`The ${formatCount(summary.total)} most-downloaded ${noun} on ${registry?.display_name ?? 'the registry'}, ranked with observed publishing provenance.`}
  canonicalPage={packagePage?.page}
>
  <header class="page-heading">
    <h1>All tracked {noun}</h1>
    <p>
      The full tracked set: the top {formatCount(summary.total)}
      {noun} on{' '}
      {registry?.display_name ?? 'the registry'} by total downloads, in rank order.{' '}
      {formatCount(summary.provenant)} carry provenance on at least one release.
    </p>
  </header>

  <section class="panel">
    <div class="table-wrap">
      <table>
        <caption class="visually-hidden"
          >{registry?.display_name ?? 'Registry'} tracked packages in download-rank order</caption
        >
        <thead>
          <tr>
            <th class="num">Rank</th>
            <th>Package</th>
            <th class="num hide-mobile">Downloads</th>
            <th class="num">Provenance</th>
          </tr>
        </thead>
        <tbody>
          {
            packages.map((pkg) => (
              <tr>
                <td class="num">#{formatCount(pkg.rank ?? 0)}</td>
                <td>
                  <a class="package-name" href={site.packagePath(pkg.name)}>
                    {pkg.name}
                  </a>
                </td>
                <td class="num hide-mobile">{formatCount(pkg.downloads_total ?? 0)}</td>
                <td class="num">
                  {pkg.first_provenant_at ? (
                    <span class="badge yes">Since {shortDate(pkg.first_provenant_at)}</span>
                  ) : (
                    <span class="badge neutral">Not observed</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {
      packagePage && (
        <Pagination
          path={site.packagesPath}
          page={packagePage.page}
          pageCount={packagePage.pageCount}
          label={`${registry?.display_name ?? 'Registry'} package pages`}
        />
      )
    }
  </section>
</Base>
