---
import Base from '../layouts/Base.astro';
import AdoptionHistory from './AdoptionHistory.astro';
import { getDb } from '../lib/db.ts';
import { latestReleaseCoverage, recentConversions, registryByName, snapshotSeries, topPackages } from '../lib/d1.ts';
import { formatCount, packageNoun, percentage, safeHttpsUrl, shortDate } from '../lib/format.ts';
import { registrySite, type RegistrySlug } from '../lib/registries.ts';

interface Props {
  slug: RegistrySlug;
}

const { slug } = Astro.props;
const site = registrySite(slug);
const db = getDb();
const registry = await registryByName(db, slug);
const [series, coverage, conversions, top] = registry
  ? await Promise.all([
      snapshotSeries(db, registry.id),
      latestReleaseCoverage(db, registry.id),
      recentConversions(db, registry.id),
      topPackages(db, registry.id),
    ])
  : ([[], null, [], []] as const);
const snapshot = series[0];
const negativeSignal = slug === 'rubygems' ? 'attestations' : 'trusted-publisher metadata';

const adoptionRate = snapshot ? percentage(snapshot.provenant_packages, snapshot.tracked_packages) : 0;
const versionRate = snapshot ? percentage(snapshot.provenant_versions, snapshot.tracked_versions) : 0;
const packageWord = packageNoun(registry?.name, coverage?.total ?? 2);
const singularPackage = packageNoun(registry?.name);
const registryUrl = safeHttpsUrl(registry?.url);
---

<Base
  registry={slug}
  canonicalPath={site.overviewPath}
  title={slug === 'cratesio' && registry ? `${registry.display_name} · rakkan` : undefined}
  description={`Trusted publishing adoption among the most-downloaded ${packageWord} on ${registry?.display_name ?? 'the selected registry'}.`}
>
  {!registry || !coverage ? (
    <section class="empty-state">
      <h1>No data yet</h1>
      <p>Package data is not available for this registry yet. Please check back later.</p>
    </section>
  ) : !snapshot ? (
    <section class="empty-state">
      <h1>No complete snapshot yet</h1>
      <p>
        {registry.display_name} package data is loaded, but rakkan has not recorded an adoption point for an incomplete
        provenance refresh.
      </p>
      <a href={site.packagesPath}>Browse the tracked packages →</a>
    </section>
  ) : (
    <>
      <section class="registry-hero">
        <div class="hero-copy">
          <h1>{registry.display_name}</h1>
          <p>
            Trusted publishing adoption among the top {formatCount(coverage.total)} {packageWord} by total downloads.{' '}
            {site.adoptionDescription(singularPackage)}
          </p>
        </div>
        <div class="hero-actions">
          {registryUrl && (
            <a class="url" href={registryUrl}>
              {new URL(registryUrl).host} ↗
            </a>
          )}
        </div>
      </section>

      <section class="stats-grid" aria-label="Publishing provenance">
        <article class="stat-card featured">
          <span class="stat-label">Historical adoption</span>
          <strong class="stat-value">{adoptionRate}%</strong>
          <span class="stat-detail">
            {formatCount(snapshot.provenant_packages)} of {formatCount(snapshot.tracked_packages)} {packageWord} had
            provenance on a non-yanked release as of{' '}
            <time datetime={snapshot.taken_on}>{shortDate(snapshot.taken_on)}</time>.
          </span>
        </article>
        <article class="stat-card">
          <span class="stat-label">Latest release coverage</span>
          <strong class="stat-value">
            {coverage.total === coverage.unknown
              ? 'Pending'
              : `${coverage.unknown > 0 ? '≥' : ''}${percentage(coverage.observed, coverage.total)}%`}
          </strong>
          <span class="stat-detail">
            {formatCount(coverage.observed)} of {formatCount(coverage.total)} {packageWord} have evidence on at least
            one non-yanked release marked latest in the registry dump.
          </span>
          <span class="stat-note">
            {formatCount(coverage.checked_without_evidence)} checked without {negativeSignal} ·{' '}
            {formatCount(coverage.unknown)} unresolved
          </span>
        </article>
        <article class="stat-card">
          <span class="stat-label">Versions with provenance</span>
          <strong class="stat-value">{formatCount(snapshot.provenant_versions)}</strong>
          <span class="stat-detail">
            {versionRate}% of {formatCount(snapshot.tracked_versions)} tracked versions in the same snapshot.
          </span>
        </article>
      </section>

      <AdoptionHistory series={series} description={site.historyDescription} />

      <div class="content-grid">
        <section class="panel">
          <header class="panel-header">
            <div>
              <h2>Recently adopted</h2>
              <p>Ordered by first release with provenance.</p>
            </div>
          </header>
          <div class="table-wrap">
            <table>
              <caption class="visually-hidden">Packages most recently observed publishing with provenance</caption>
              <thead>
                <tr>
                  <th>Package</th>
                  <th class="num">Rank</th>
                  <th class="num">Since</th>
                </tr>
              </thead>
              <tbody>
                {conversions.length === 0 && (
                  <tr>
                    <td colspan="3">No adoption observed yet.</td>
                  </tr>
                )}
                {conversions.map((pkg) => (
                  <tr>
                    <td>
                      <a class="package-name" href={site.packagePath(pkg.name)}>
                        {pkg.name}
                      </a>
                    </td>
                    <td class="num">#{formatCount(pkg.rank ?? 0)}</td>
                    <td class="num date-cell">{shortDate(pkg.first_provenant_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <header class="panel-header">
            <div>
              <h2>Most downloaded</h2>
              <p>Ranked by total downloads.</p>
            </div>
            <span class="panel-meta">
              <a href={site.packagesPath}>browse all →</a>
            </span>
          </header>
          <div class="table-wrap">
            <table>
              <caption class="visually-hidden">Most-downloaded tracked packages and provenance status</caption>
              <thead>
                <tr>
                  <th>Package</th>
                  <th class="num">Rank</th>
                  <th class="num">Status</th>
                </tr>
              </thead>
              <tbody>
                {top.map((pkg) => (
                  <tr>
                    <td>
                      <a class="package-name" href={site.packagePath(pkg.name)}>
                        {pkg.name}
                      </a>
                    </td>
                    <td class="num">#{formatCount(pkg.rank ?? 0)}</td>
                    <td class="num">
                      {pkg.first_provenant_at ? (
                        <span class="badge yes">With provenance</span>
                      ) : (
                        <span class="badge neutral">None observed</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </>
  )}
</Base>
