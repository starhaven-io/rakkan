---
import '../styles/site.css';
import { getDb } from '../lib/db.ts';
import { exportGeneratedAt } from '../lib/d1.ts';
import { utcStamp } from '../lib/format.ts';

interface Props {
  title?: string;
  query?: string;
  freshness?: boolean;
}

const { title = 'rakkan · trusted publishing adoption', query = '', freshness = true } = Astro.props;

// Freshness note in the header: when this dataset was built (the export
// runs only after ingest succeeds, so this never overstates). Best-effort:
// on an unloaded local D1 it simply renders nothing. Pages that should not
// pay a D1 read for it (the 404 page) opt out via the freshness prop.
let updatedAt: string | null = null;
if (freshness) {
  try {
    updatedAt = utcStamp(await exportGeneratedAt(getDb()));
  } catch {
    updatedAt = null;
  }
}

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='14' fill='%23b3271e'/%3E%3Ctext x='50' y='57' font-size='60' text-anchor='middle' dominant-baseline='middle' fill='%23fdf9f4' font-family='serif'%3E落%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf7f2" />
    <title>{title}</title>
    <link rel="icon" href={favicon} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="rakkan home">
          <span class="brand-mark" aria-hidden="true">落</span>
          <span class="brand-copy">
            <span class="brand-name">rakkan</span>
            {updatedAt && <span class="header-note">updated {updatedAt}</span>}
          </span>
        </a>
        <nav class="registry-nav" aria-label="Package registries">
          <a class="registry-tab active" href="/" aria-current="page">RubyGems.org</a>
          <span class="registry-tab future">crates.io <small>next</small></span>
          <span class="nav-sep" aria-hidden="true"></span>
          <a class="registry-tab" href="/packages">All packages</a>
        </nav>
        <form class="site-search" action="/search" method="get">
          <input
            type="search"
            name="q"
            value={query}
            placeholder="search packages"
            aria-label="Search packages by name"
          />
          <button type="submit">Search</button>
        </form>
        <a class="gh" href="https://github.com/starhaven-io/rakkan" aria-label="Source on GitHub">
          <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </div>
    </header>
    <main class="page-shell">
      <slot />
    </main>
    <footer class="site-footer">
      rakkan (落款): the seal an artist stamps on a work to certify it. This site tracks verifiable publishing
      provenance across package registries, from public APIs and data dumps only; no registry HTML is scraped.
    </footer>
  </body>
</html>
