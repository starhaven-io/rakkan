{
  "name": "rakkan-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test",
    "test:coverage": "cd .. && ./site/node_modules/.bin/c8 --all --include='site/src/lib/**/*.ts' --reports-dir=site/coverage --reporter=text --reporter=lcov node --test 'site/test/**/*.test.ts'",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry": "npm run deploy -- --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "wrangler": "4.123.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  }
}
