{
  "name": "rakkan-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test",
    "test:coverage": "cd .. && ./site/node_modules/.bin/c8 --all --include='site/src/lib/**/*.ts' --reports-dir=site/coverage --reporter=text --reporter=lcov node --test 'site/test/**/*.test.ts'",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry": "npm run deploy -- --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "c8": "12.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "4.124.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  }
}
