#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"

def announce(message)
  puts "\e[1m#{message}\e[0m"
end

Dir.chdir(File.expand_path("..", __dir__))

announce "Installing engine dependencies..."
system("bundle", "install", exception: true) unless system("bundle", "check")

unless File.file?(".env")
  announce "Creating .env from .env.example..."
  FileUtils.cp(".env.example", ".env")
end

engine_env = { "HANAMI_LOG_LEVEL" => "info" }
announce "Preparing the databases..."
system(engine_env, "bundle", "exec", "hanami", "db", "prepare", exception: true)

announce "Loading the tracked sets from seed data (no network)..."
%w[ingest:seed ingest:seed[cratesio] snapshot:take].each do |task|
  system(engine_env, "bundle", "exec", "rake", task, exception: true)
end

announce "Installing site dependencies..."
system("node", "scripts/check-npm-install-policy.mjs", "site", exception: true)
system("npm", "ci", "--strict-allow-scripts", chdir: "site", exception: true)

announce "Exporting to the site's local D1..."
system(engine_env, "bundle", "exec", "rake", "export:d1", exception: true)
system({ "WRANGLER_WRITE_LOGS" => "false" }, "./node_modules/.bin/wrangler", "d1", "execute",
       "rakkan", "--local", "--file=../db/d1_export.sql", chdir: "site", out: File::NULL, exception: true)

announce "🌸 Setup complete. Start the site with: just dev"
