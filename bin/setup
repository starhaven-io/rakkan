#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# Idempotent fresh-clone setup: the engine (Ruby, SQLite), its seed data,
# and the site (Astro on a local D1). Safe to re-run at any time.

announce() {
  local bold='\033[1m'
  local reset='\033[0m'
  printf "${bold}%s${reset}\n" "$1"
}

cd "$(dirname "$0")/.."

announce "Installing engine dependencies..."
bundle check || bundle install

if [ ! -f .env ]; then
  announce "Creating .env from .env.example..."
  cp .env.example .env
fi

announce "Preparing the databases..."
HANAMI_LOG_LEVEL=info bundle exec hanami db prepare

announce "Loading the tracked sets from seed data (no network)..."
HANAMI_LOG_LEVEL=info bundle exec rake ingest:seed
HANAMI_LOG_LEVEL=info bundle exec rake "ingest:seed[cratesio]"
HANAMI_LOG_LEVEL=info bundle exec rake snapshot:take

announce "Installing site dependencies..."
node scripts/check-npm-install-policy.mjs site
(cd site && npm ci --strict-allow-scripts)

announce "Exporting to the site's local D1..."
HANAMI_LOG_LEVEL=info bundle exec rake export:d1
(cd site && WRANGLER_WRITE_LOGS=false ./node_modules/.bin/wrangler d1 execute \
  rakkan --local --file=../db/d1_export.sql > /dev/null)

announce "🌸 Setup complete. Start the site with: just dev"
